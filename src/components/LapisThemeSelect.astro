<starlight-theme-select class="site-theme-select">
  <label>
    <span class="sr-only">Select theme</span>
    <select value="auto" autocomplete="off" aria-label="Select theme">
      <option value="dark">Dark</option>
      <option value="light">Light</option>
      <option value="auto" selected>Default</option>
    </select>
  </label>
</starlight-theme-select>

<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  import { initThemeSelect } from "../lib/lapis-theme";

  initThemeSelect();
</script>

