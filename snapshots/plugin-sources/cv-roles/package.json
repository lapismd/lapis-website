{
  "name": "@lapis-notes/lapis-plugin-cv-roles",
  "version": "0.1.0",
  "description": "Lapis Notes vault-native roles and retained CV views",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-plugin-cv-roles.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm spec:validate && pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:storybook": "vitest run --project storybook",
    "build-storybook": "NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" storybook build --config-dir .storybook --output-dir storybook-static",
    "publint": "publint",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && publint",
    "spec:build": "mdbook build ./spec",
    "spec:check": "pnpm spec:validate && pnpm spec:test && pnpm spec:build && pnpm spec:first",
    "spec:first": "node ./scripts/spec-validation/check-spec-first.mjs",
    "spec:test": "node --test ./scripts/spec-validation/*.spec.mjs",
    "spec:validate": "node ./scripts/spec-validation/index.mjs",
    "standalone:smoke": "node ./scripts/standalone-smoke.mjs",
    "storybook": "STORYBOOK_PORT=7020 storybook dev -p 7020 --no-open --config-dir .storybook"
  },
  "files": [
    "dist",
    "static",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#cv-assets/*": "./static/*"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@lucide/svelte": "^0.523.0",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@lapis-notes/api": "^0.0.1",
    "@codemirror/language": "^6.11.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@lapismd/design-core": "^0.3.1",
    "@lapismd/mira": "~0.0.3",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@codemirror/language": "6.11.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.42.1",
    "@fontsource-variable/source-code-pro": "5.2.7",
    "@lapis-notes/api": "0.1.0",
    "@lapis-notes/ui": "0.1.0",
    "@lapismd/design-core": "0.3.1",
    "@lapismd/mira": "0.0.3",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/svelte-vite": "10.5.7",
    "@sveltejs/package": "2.5.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "4.1.12",
    "@tsconfig/svelte": "5.0.5",
    "publint": "0.3.12",
    "storybook": "10.5.7",
    "tailwindcss": "4.1.12",
    "svelte": "5.56.9",
    "svelte-check": "4.3.1",
    "typescript": "~5.8.3",
    "vite": "6.4.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/browser": "4.1.10",
    "aria-query": "5.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vitest": "4.1.10"
  }
}
