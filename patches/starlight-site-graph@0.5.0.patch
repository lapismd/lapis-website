--- /dev/null
+++ b/components/graph/path-patterns.js
@@ -0,0 +1,7 @@
+/** Match server-compiled globs without Node-only modules in the browser. */
+export function firstMatchingPattern(text, patterns, defaultMatch) {
+  for (const pattern of patterns) {
+    if (new RegExp(pattern.source, pattern.flags).test(text)) return pattern.include;
+  }
+  return defaultMatch;
+}
